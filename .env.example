# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Admin password for the /admin page. Change this to something strong.
ADMIN_PASSWORD=change-me

# Optional WhatsApp group invite link shown on the public page.
# Leave empty to hide the "Join WhatsApp group" button.
WHATSAPP_GROUP_URL=

# Postgres connection string. On Vercel, use Neon / Supabase / any Postgres.
# Without this, the app uses a local JSON file (great for preview, not for production).
DATABASE_URL=
